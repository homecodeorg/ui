.root
  display flex
  flex-direction column
  gap 16px
  width 100%

.subtitle
  font-size 12px
  opacity 0.65

.box
  height 160px
  border 1px solid var(--accent-color-alpha-200)
  border-radius var(--border-radius-l)
  overflow hidden

.boxTall
  height 240px
  border 1px solid var(--accent-color-alpha-200)
  border-radius var(--border-radius-l)
  overflow hidden

.pane
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 6px
  height 100%
  background var(--surface-color)

.size
  font-variant-numeric tabular-nums
  font-weight 600
  font-size 20px
