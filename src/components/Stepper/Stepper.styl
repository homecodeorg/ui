@import '../../theme'

.root
  display flex
  flex-direction column
  gap 16px
  min-width 0

.body
  position relative
  min-width 0

.step
  display flex
  flex-direction column
  gap 16px
  min-width 0

  &.hidden
    display none

  &.forward
    animation stepFromRight .22s ease-out

  &.back
    animation stepFromLeft .22s ease-out

@keyframes stepFromRight
  from
    opacity 0
    transform translateX(24px)
  to
    opacity 1
    transform none

@keyframes stepFromLeft
  from
    opacity 0
    transform translateX(-24px)
  to
    opacity 1
    transform none

.header
  display flex
  flex-direction column
  gap 4px

.title
  font-size 1.4em
  font-weight 600
  line-height 1.2

.description
  opacity .6
  line-height 1.4

.content
  display flex
  flex-direction column
  gap 12px
  min-width 0

.footer
  display grid
  grid-template-columns 1fr auto 1fr
  align-items center
  gap 12px

.prev
.next
  display flex
  align-items center
  gap 8px
  min-width 0

.prev
  justify-self start
  grid-column 1

.next
  justify-self end
  grid-column 3

.placeholder
  display block

// The Gallery dots, drawn in the footer instead of over the picture.
.dots
  position static
  width auto
  padding 0
  mask-image none
  grid-column 2

// Small screens: buttons on the first row, dots on their own row below.
@media (max-width: $tablet)
  .footer
    grid-template-columns 1fr 1fr
    row-gap 0

  .prev
  .next
    grid-row 1

  .next
    grid-column 2

  .dots
    grid-row 2
    grid-column 1 / -1
    justify-self center
    // The removed row gap goes into the dots line; dots sit in its middle.
    min-height calc(14px + 12px) // dot (8px + 3px margins) + the footer gap
    align-items center

.size-s .title
  font-size 1.15em

.size-l .title
  font-size 1.7em

@media (prefers-reduced-motion: reduce)
  .step
    animation none !important
