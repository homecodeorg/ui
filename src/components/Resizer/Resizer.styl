@import '../../theme'

.root
  display flex
  flex-direction row
  width 100%
  height 100%
  min-width 0
  min-height 0

  &.vertical
    flex-direction column

  &.dragging
    user-select none
    cursor col-resize

    &.vertical
      cursor row-resize

.pane
  box-sizing border-box
  flex-shrink 0
  min-width 0
  min-height 0
  overflow hidden
  width var(--width)
  height 100%

.root.vertical .pane
  width 100%
  height var(--height)

.handle
  position relative
  flex-shrink 0
  width 0
  z-index 1
  cursor col-resize
  touch-action none
  user-select none

  &::before
    content ''
    position absolute
    top 0
    bottom 0
    left -4px
    width 8px

  &::after
    content ''
    position absolute
    top 0
    bottom 0
    left -1px
    width 2px
    background var(--accent-color-alpha-300)

  &:hover::after
    background var(--active-color)

.root.vertical .handle
  width auto
  height 0
  cursor row-resize

  &::before
    top -4px
    bottom auto
    left 0
    right 0
    width auto
    height 8px

  &::after
    top -1px
    bottom auto
    left 0
    right 0
    width auto
    height 2px
