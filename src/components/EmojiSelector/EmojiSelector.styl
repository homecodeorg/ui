@import '../../theme'

$cell = 36px
$columns = 8
// Space between the wrapper's edge and the tab buttons. The search field
// sits flush against the wrapper's top and sides.
$tabPad = 4px

.root
  // Corner radius of the wrapper (a Popup), read on mount; inner corners
  // follow it minus the space between, so they stay concentric.
  --emoji-selector-radius 12px
  display flex
  flex-direction column
  box-sizing border-box
  width 'calc(%s * %s + 16px)' % ($cell $columns)
  max-width 100%
  height 360px
  max-height 100%
  padding 0

.search
  flex none
  box-sizing border-box
  width auto
  min-width 0
  margin 0

  > label
    box-sizing border-box
    width 100%
    min-width 0

  input
    width 100%
    min-width 0

// Flush with the wrapper: same top corners (beats Input's own radius),
// square at the bottom, where the list starts.
.root .search > label
  $r = var(--emoji-selector-radius)
  border-radius $r $r 0 0

.list
  position relative
  flex 1
  min-height 0
  overflow-y auto
  overscroll-behavior contain
  padding 0 8px 4px

.section
  padding-bottom 4px

// Sticks while its emoji scroll by, like the macOS picker. Spans the list's
// side padding so the emoji pass under it edge to edge.
.sectionTitle
  position sticky
  top 0
  z-index 1
  margin 0 -8px
  padding 6px 10px 4px
  background var(--decent-color-alpha-800)
  backdrop-filter blur(10px)
  -webkit-backdrop-filter blur(10px)
  color var(--accent-color-alpha-500)
  font-size 11px
  font-weight 600
  letter-spacing 0.02em

.grid
  display grid
  // Cells shrink when the popup is narrower than eight full cells (phones).
  grid-template-columns repeat($columns, minmax(0, 1fr))

.emoji
  display flex
  align-items center
  justify-content center
  width 100%
  max-width $cell
  aspect-ratio 1
  padding 0
  border none
  border-radius 8px
  background none
  font-size 24px
  line-height 1
  font-family 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif
  cursor pointer

  &:hover
    background var(--accent-color-alpha-100)

  &:focus-visible
    outline 2px solid var(--active-color)
    outline-offset -2px

.chosen
  background var(--active-color-alpha-200)

.empty
  padding 24px 8px
  text-align center
  color var(--accent-color-alpha-500)
  font-size 13px

.tabs
  display flex
  justify-content space-between
  gap $tabPad
  padding $tabPad
  border-top 1px solid var(--accent-color-alpha-100)

.tab
  display flex
  align-items center
  justify-content center
  flex 1
  height 28px
  padding 0
  border none
  // Concentric with the wrapper's bottom corners; every tab the same.
  border-radius unquote('max(6px, calc(var(--emoji-selector-radius) - %s))' % $tabPad)
  background none
  font-size 16px
  line-height 1
  filter grayscale(1)
  opacity 0.55
  cursor pointer
  transition opacity 0.15s ease

  &:hover
    opacity 0.85

.tabActive
  filter none
  opacity 1
  background var(--accent-color-alpha-100)
