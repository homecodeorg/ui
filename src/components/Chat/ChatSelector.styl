.root
  position relative
  flex 1 1 auto
  min-width 0
  max-width 100%

.folded
  display flex
  align-items center
  width 100%
  min-width 0
  min-height 36px
  padding 0 4px 0 12px
  border-radius var(--p-5)
  background-color var(--accent-color-alpha-50)
  box-shadow 0 0 0 1px var(--active-color-alpha-100)

.title
  flex 1 1 auto
  min-width 0
  margin 0
  padding 0
  border 0
  background none
  color inherit
  font inherit
  font-weight 650
  letter-spacing -0.02em
  text-align left
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  cursor text

  &:disabled
    cursor default

.edit
  flex-shrink 0
  opacity .5
  transition opacity .2s ease-out

  .folded:hover &
    opacity 1

.input
  width 100%
  min-width 0
  font-size inherit !important

  label
    font-size inherit !important
    border-radius var(--p-5) !important

.list
  position absolute
  z-index 6
  top calc(100% + 4px)
  left 0
  right 0
  min-width 0
  max-height 280px
  border-radius var(--p-3)
  background var(--bg-color, #1a1a1a)
  box-shadow 0 8px 24px rgba(0, 0, 0, .4)

.item
  max-width 320px

.newChat
  font-weight 650

.selected
  font-weight 650

.empty
  opacity .6
