@import '../../theme'

.bullet
  display inline-block
  margin-left var(--p-2)
  margin-bottom 2px
  margin-right 2px

  &::before
    content ''
    display block
    width 6px
    height 6px
    background-color var(--accent-color)
    border-radius 50%
    margin 0 4px

.numberedIndex
  display inline-block
  min-width 1.25em
  margin-left var(--p-2)
  margin-right 6px
  font-variant-numeric tabular-nums
  color var(--accent-color)

.line
  width 100%
  height 2px
  border-radius 2px
  background-color var(--accent-color-alpha-200)
  margin var(--p-2) 0

.codeInline
.codeBlock
  font-family monospace
  background-color var(--decent-color-alpha-400)
  box-shadow 0 1px 1px var(--accent-color-alpha-50), inset 0 1px 1px var(--decent-color-alpha-500)
  border-radius var(--p-2)
  user-select text

.codeInline
  display inline
  padding 0 4px
  border-radius 3px
  font-size 90%

.codeBlock
  display block
  padding var(--p-2)
  margin var(--p-2) 0
  font-size 90%
  white-space pre-wrap
  overflow-x auto

.jsonPre
  display block
  padding var(--p-2)
  margin var(--p-2) 0
  max-width 100%
  background-color var(--decent-color-alpha-300)
  box-shadow 0 1px 1px var(--accent-color-alpha-50), inset 0 1px 1px var(--accent-color-alpha-50)
  border-radius var(--p-2)
  font-family monospace
  font-size 90%
  white-space pre-wrap
  overflow-x auto
  user-select text

.table
  margin-bottom 10px
