@import '../../theme'

.dialogOverlay
  position fixed
  inset 0
  z-index 10
  background-color var(--decent-color-alpha-900)
  backdrop-filter blur(4px)
  opacity 0
  transition opacity 200ms ease-out

  &.isOpen
    opacity 1
    animation-name fadeIn
    animation-duration 200ms
    animation-timing-function ease-out
    animation-fill-mode forwards

.dialogContent
  position fixed
  left 50%
  top 50%
  z-index 10
  display flex
  flex-direction column
  width fit-content
  max-height calc(100% - var(--p-5))
  border-radius var(--border-radius-l)
  box-shadow 0 10px 20px rgba(0, 0, 0, 0.3), 0 0 0 2px var(--decent-color-alpha-800)
  transition opacity 200ms ease-out, transform 200ms ease-out
  opacity 0
  transform translateX(-50%) translateY(-50%) scale(0.95)

  &.isOpen
    opacity 1
    transform translateX(-50%) translateY(-50%) scale(1)
    animation-name dialogueIn
    animation-duration 200ms
    animation-timing-function ease-out
    animation-fill-mode forwards

  &.isClosed
    opacity 0
    transform translateX(-50%) translateY(-50%) scale(0.95)
    animation-name dialogueOut
    animation-duration 200ms
    animation-timing-function ease-in
    animation-fill-mode forwards
    pointer-events none

  @media (max-width: $tablet)
    width calc(100% - var(--p-5))

  // The dialogue's spacing lives on its slots instead of on the Card, so the
  // scroll area reaches the dialogue's edges and its content gets the spacing
  // back as inner padding. Focus rings, glows and shadows of the content then
  // have room to render instead of being clipped by the scroll container.
  // `[role]` lifts specificity over Card's `.root.padding-*`.
  &[role="dialog"]
    --dialog-padding: var(--p-5)
    // header sits higher and footer lower than the content's inset
    --dialog-edge-padding: calc(var(--dialog-padding) - var(--p-2))
    padding 0
    gap 0
    min-width 0

  & > [data-slot="card-header"]
    flex-shrink 0
    min-width 0
    padding var(--dialog-edge-padding) var(--dialog-padding) 0

  &:has(.dialogClose) > [data-slot="card-header"]
    padding-right calc(var(--dialog-padding) + 2rem + var(--p-3))

  & > [data-slot="card-scroll"]
    width auto
    min-height 0
    margin 0
    padding 0

  & > [data-slot="card-scroll"] > * > [data-slot="card-content"]
  & > [data-slot="card-content"]
    min-width 0
    padding var(--dialog-padding)
    overflow-wrap anywhere

  & > [data-slot="card-footer"]
    flex-shrink 0
    min-width 0
    padding 0 var(--dialog-padding) var(--dialog-edge-padding)

  // Without content the header and footer keep the Card's outer spacing
  &:not(:has([data-slot="card-content"])) > [data-slot="card-footer"]
    padding-top var(--dialog-padding)
  &:not(:has([data-slot="card-content"])):not(:has([data-slot="card-footer"])) > [data-slot="card-header"]
    padding-bottom var(--dialog-padding)

.size-default
  max-width unquote('min(40rem, calc(100% - var(--p-5)))')

.size-login
  max-width unquote('min(24rem, calc(100% - var(--p-5)))')

.size-wide
  max-width calc(100% - var(--p-5))
  @media (min-width: $tablet)
    max-width 80rem

.dialogClose
  position absolute
  right var(--p-3)
  top var(--p-3)
  z-index 10
  display flex
  align-items center
  justify-content center
  height 2rem
  width 2rem
  border-radius var(--border-radius-s)
  opacity 0.3
  outline none
  transition opacity 200ms ease, transform 200ms ease
  transform-origin center
  cursor pointer
  background-color transparent
  border none
  color var(--accent-color)

  &:hover
  &:focus-visible
    opacity 1
    transform scale(1.1)

  &:focus-visible
    box-shadow 0 0 0 2px var(--active-color)

  &:disabled
    pointer-events none

@keyframes fadeIn
  from
    opacity 0
  to
    opacity 1

@keyframes dialogueIn
  from
    opacity 0
    transform translateX(-50%) translateY(-50%) scale(0.95)
  to
    opacity 1
    transform translateX(-50%) translateY(-50%) scale(1)

@keyframes dialogueOut
  from
    opacity 1
    transform translateX(-50%) translateY(-50%) scale(1)
  to
    opacity 0
    transform translateX(-50%) translateY(-50%) scale(0.95)

.footerAlignLeft
  justify-content flex-start

.footerAlignCenter
  justify-content center

.footerAlignRight
  justify-content flex-end
