@property --promptGlowAngle
  syntax '<angle>'
  inherits true
  initial-value 0deg

$color = var(--tol-color, var(--active-color))
$soft = var(--tol-color-soft, var(--active-color-alpha-300))
$thickness = var(--tol-thickness, 1.5px)
$spread = var(--tol-spread, 20px)

// Two tapered arcs 180deg apart, clipped to a ring of `thickness` around the inherited radius.
// Arcs peak at 0deg/180deg so --promptGlowAngle equals their on-screen position
glowRing(thickness)
  content ''
  position absolute
  inset 0
  padding thickness
  border-radius inherit
  background conic-gradient(from var(--promptGlowAngle), $color 0deg, $soft 48deg, transparent 80deg, transparent 100deg, $soft 132deg, $color 180deg, $soft 228deg, transparent 260deg, transparent 280deg, $soft 312deg, $color 360deg)
  -webkit-mask linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0)
  -webkit-mask-composite xor
  mask linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0)
  mask-composite exclude

.root
  position absolute
  inset 0
  border-radius inherit
  pointer-events none
  transition opacity 0.5s ease-out
  opacity 0

  &.interactive
    pointer-events auto

  &.interactive:hover
  &.active
    opacity 1

  &.interactive:hover .layer
  &.active .layer
    animation-play-state running

// One orbiting gradient; several can stack inside a root, each with its own speed
.layer
  position absolute
  inset 0
  border-radius inherit
  animation orbitGlow var(--tol-duration, 3.5s) linear infinite
  animation-delay var(--tol-delay, 0s)
  animation-direction var(--tol-direction, normal)
  animation-play-state paused

  &::before
    glowRing($thickness)

.bloom
  position absolute
  inset 0
  border-radius inherit
  opacity .55
  filter blur($spread)

  &::before
    glowRing(calc(4 * var(--tol-thickness, 1.5px)))

// Equal time per quarter over unequal spans: the 60deg sectors facing the top/bottom
// edges get twice the time-per-degree of the 120deg sectors around the short ends
@keyframes orbitGlow
  0%
    --promptGlowAngle -30deg
  25%
    --promptGlowAngle 30deg
  50%
    --promptGlowAngle 150deg
  75%
    --promptGlowAngle 210deg
  100%
    --promptGlowAngle 330deg

@media (prefers-reduced-motion: reduce)
  .layer
    animation none
