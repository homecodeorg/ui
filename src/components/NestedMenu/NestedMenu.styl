@import '../../theme'

.root
  display inline-flex

.trigger
  display inline-flex

.content
  box-sizing border-box
  width fit-content
  min-width 0
  max-width unquote('min(100vw - 16px, 360px)')
  padding 4px

.list
  display flex
  flex-direction column
  gap 1px

.itemPopup
  display block
  width 100%

.itemTrigger
  display block
  width 100%
  cursor unset

.itemWrap
  position relative

.item
.row
.back
  display flex
  align-items center
  gap 8px
  width 100%
  border none
  background none
  color inherit
  font inherit
  font-weight 500
  letter-spacing 0.01em
  line-height 1.3
  text-align left
  text-decoration none
  cursor pointer

  &:hover
    background var(--accent-color-alpha-50)
  &.itemActive
    background var(--accent-color-alpha-100)

  &:disabled
  &.itemDisabled
    opacity 0.55
    cursor default
    pointer-events none

.itemDanger
  color var(--active-color)

  .icon
    opacity 1
    color inherit

.icon
  flex-shrink 0
  display inline-flex

  svg
    display block

.text
  flex 1 1 auto
  min-width min-content
  display flex
  flex-direction column
  justify-content center
  gap 0

  .label
    flex none

.hint
  flex-shrink 0
  margin 0
  opacity 0.5
  font-weight 400
  line-height 1.2
  white-space nowrap

.label
  flex 1
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  line-height 1.2

.wrap
  .text
    min-width 0

  .label
    overflow visible
    text-overflow unset
    white-space normal

  .hint
    min-width 0
    white-space normal

.chevron
  flex-shrink 0
  opacity 0.45

.row svg
  flex-shrink 0
  color var(--active-color)

.stacked
  display flex
  flex-direction column
  max-height unquote('min(360px, calc(100vh - 24px))')
  overflow-y auto

.back
  font-weight 650
  margin-bottom 2px

.stackedBody
  min-width 0

.size-xs
  .item
  .row
  .back
    borderRadiusSize('xs')

.size-s
  .item
  .row
  .back
    borderRadiusSize('s')

.size-xs
.size-s
  .item
  .row
  .back
    padding 4px 8px
    font-size 12px
    gap 6px

  &.content
    padding 3px

  .icon svg
  .chevron
  .row svg
  .back svg
    width 10px
    height 10px

.size-m
  .item
  .row
  .back
    borderRadiusSize('m')
    padding 6px 10px
    font-size 13px

.size-l
  .item
  .row
  .back
    borderRadiusSize('l')
    padding 10px 14px
    font-size 16px
    gap 10px

  &.content
    padding 6px
    max-width 320px

  .icon svg
  .chevron
  .row svg
  .back svg
    width 18px
    height 18px

.size-xl
  .item
  .row
  .back
    borderRadiusSize('xl')
    padding 12px 16px
    font-size 18px
    gap 12px

  &.content
    padding 8px
    max-width 360px

  .icon svg
  .chevron
  .row svg
  .back svg
    width 22px
    height 22px

.search
  min-width 120px
  margin-bottom 4px

  // The items set the menu width, not the input's intrinsic size.
  input
    width 100%
    min-width 0

// Match the item rows: Input's own control sizes are taller than menu items.
searchSize(size, padY, padX, fontSize)
  $h = 'calc(%s * 2 + %s * 1.2)' % (padY fontSize)
  .search > label
    height $h
    min-height 0
    padding-left padX
    font-size fontSize
    borderRadiusSize(size)

  .searchEmpty
    padding padY padX
    font-size fontSize

  // Clear button: a square as tall as the field, so the cross is centered.
  .search > label > button
    top 0
    bottom 0
    height $h
    min-height 0
    width $h
    min-width 0
    padding 0

.size-xs
  searchSize('xs', 4px, 8px, 12px)
.size-s
  searchSize('s', 4px, 8px, 12px)
.size-m
  searchSize('m', 6px, 10px, 13px)
.size-l
  searchSize('l', 10px, 14px, 16px)
.size-xl
  searchSize('xl', 12px, 16px, 18px)

.searchList
  display flex
  flex-direction column
  gap 1px
  max-height 320px
  overflow-y auto

.searchEmpty
  opacity 0.6
  font-weight 500
  line-height 1.2
  white-space nowrap
