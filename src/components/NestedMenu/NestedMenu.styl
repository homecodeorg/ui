@import '../../theme'

.root
  display inline-flex

.trigger
  display inline-flex

.content
  box-sizing border-box
  min-width 200px
  max-width 280px
  padding 4px

.list
  display flex
  flex-direction column
  gap 1px

.itemPopup
  display block
  width 100%

.itemTrigger
  display block
  width 100%
  cursor unset

.itemWrap
  position relative

.item
.row
.back
  display flex
  align-items center
  gap 8px
  width 100%
  border none
  border-radius 6px
  background none
  color inherit
  font inherit
  font-weight 500
  letter-spacing 0.01em
  line-height 1.3
  text-align left
  text-decoration none
  cursor pointer

  &:hover
    background var(--accent-color-alpha-50)
  &.itemActive
    background var(--accent-color-alpha-100)

  &:disabled
  &.itemDisabled
    opacity 0.55
    cursor default
    pointer-events none

.itemDanger
  color var(--active-color)

  .icon
    opacity 1
    color inherit

.icon
  flex-shrink 0
  display inline-flex
  opacity 0.55

  svg
    display block

.label
  flex 1
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.hint
  flex-shrink 0
  opacity 0.5
  font-weight 400

.multiline
  display grid
  grid-template-columns auto minmax(0, 1fr)
  align-items start
  row-gap 2px
  min-width 252px

  .label
    overflow visible
    text-overflow unset

  .hint
    grid-column 2
    min-width 0
    white-space normal

.chevron
  flex-shrink 0
  opacity 0.45

.row svg
  flex-shrink 0
  color var(--active-color)

.stacked
  display flex
  flex-direction column
  max-height unquote('min(360px, calc(100vh - 24px))')
  overflow-y auto

.back
  font-weight 650
  margin-bottom 2px

.stackedBody
  min-width 0

.size-xs
.size-s
  .item
  .row
  .back
    padding 4px 8px
    font-size 12px
    gap 6px

  &.content
    padding 3px
    min-width 176px

  .icon svg
  .chevron
  .row svg
  .back svg
    width 10px
    height 10px

.size-m
  .item
  .row
  .back
    padding 6px 10px
    font-size 13px

.size-l
  .item
  .row
  .back
    padding 10px 14px
    font-size 16px
    gap 10px

  &.content
    padding 6px
    min-width 240px
    max-width 320px

  .icon svg
  .chevron
  .row svg
  .back svg
    width 18px
    height 18px

.size-xl
  .item
  .row
  .back
    padding 12px 16px
    font-size 18px
    gap 12px

  &.content
    padding 8px
    min-width 260px
    max-width 360px

  .icon svg
  .chevron
  .row svg
  .back svg
    width 22px
    height 22px
