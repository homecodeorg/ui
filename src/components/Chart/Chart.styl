// No background or padding: the host adds them when it wants a card.
.root
  width 100%
  margin 0
  padding 0
  box-sizing border-box

.header
  display flex
  flex-wrap wrap
  align-items baseline
  justify-content space-between
  gap 4px 12px
  padding 0 0 8px 12px

.title
  font-weight 600
  font-size 95%

.legend
  display flex
  flex-wrap wrap
  gap 4px 12px
  font-size 80%
  color var(--accent-color-alpha-700)

.legendItem
  display inline-flex
  align-items center
  gap 6px

// `color` is the series color
.swatch
  display inline-block
  width 10px
  height 10px
  border-radius 3px
  background-color currentColor

.dashed
  height 0
  width 14px
  border-radius 0
  border-top 2px dashed currentColor
  background-color transparent

.band
  opacity 0.35

.plot
  position relative
  width 100%
  height 260px

  @media (max-width 600px)
    height 210px

.zoomable
  user-select none
  cursor crosshair

.resetZoom
  position absolute
  top 0
  right 8px
  z-index 1
  padding 2px 8px
  border none
  border-radius 8px
  font inherit
  font-size 75%
  color var(--accent-color-alpha-700)
  background-color var(--accent-color-alpha-100)
  cursor pointer

  &:hover
    color var(--accent-color)

.tooltip
  :global(.recharts-tooltip-label)
    margin 0 0 2px
    padding 0
    line-height inherit

  :global(.recharts-tooltip-item-list)
    margin 0
    padding 0
    list-style none

  :global(.recharts-tooltip-item)
    margin 0
    padding 1px 0 !important
    line-height inherit

.source
  padding 4px 4px 0 12px
  text-align right
  font-size 75%
  color var(--accent-color-alpha-500)

  a
    color inherit
