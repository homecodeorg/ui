@import '../../theme'

$radius = var(--p-3)

.root
  position relative
  display flex
  flex-direction column
  width 100%
  border-radius $radius
  overflow hidden
  outline none
  color var(--accent-color)

.videoWrap
  position relative
  display flex
  align-items center
  width 100%
  aspect-ratio 16 / 9
  overflow hidden
  border-radius inherit

.video
  display block
  width 100%
  height 100%
  object-fit contain

.loading
  position absolute
  inset 0
  display flex
  align-items center
  justify-content center
  background var(--decent-color-alpha-200)
  border-radius $radius
  backdrop-filter blur(10px)
  pointer-events none

.controls
  position absolute
  left 0
  right 0
  bottom 0
  top auto
  height auto
  width 100%
  z-index 2
  display flex
  flex-direction column
  flex-grow 0
  flex-shrink 0
  background var(--decent-color-alpha-700)
  border-bottom-left-radius $radius
  border-bottom-right-radius $radius
  // backdrop-filter blur(10px)
  transform translateY(0)
  transition transform 0.25s ease
  pointer-events none

.controlsCompact
  .size-xs &
    transform translateY(calc(100% - 1px))
  .size-s &
    transform translateY(calc(100% - 2px))
  .size-m &
    transform translateY(calc(100% - 4px))
  .size-l &
    transform translateY(calc(100% - 6px))
  .size-xl &
    transform translateY(calc(100% - 10px))

.progressRow
  width 100%
  pointer-events auto

  input
    --track-radius: 0

.progress
  width 100%
  min-width 0

  .size-xs &
    top -5px
  .size-s &
    top -6px
  .size-m &
    top -4px
  .size-l &
  .size-xl &
    top -5px

.bar
  display flex
  align-items center
  gap var(--p-2)
  padding 0 var(--p-3) var(--p-2)
  pointer-events auto

.time
  flex 1
  min-width 0
  font-variant-numeric tabular-nums
  font-size 13px
  white-space nowrap
  opacity 0.85

.volumeControl
  flex-shrink 0
  display inline-flex
  align-items center

.volumePopup
  display flex
  align-items center
  justify-content center
  padding var(--p-3) var(--p-2)
  height 120px
  box-sizing border-box

.volumeSliderWrap
  width var(--thumb-size, 16px)
  height 100%
  display flex
  align-items stretch
  justify-content center

.volumeSlider
  height 100%

.fullscreen
  border-radius 0

  .videoWrap
    border-radius 0

  :global(video)
    object-fit contain
