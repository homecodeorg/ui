.root
  position relative
  display flex
  flex-direction column
  align-items flex-start
  gap 12px
  padding 14px 16px
  background var(--decent-color-alpha-600)
  background-image linear-gradient(to right, var(--active-color-alpha-100) 0%, transparent 30%)
  border-top-right-radius var(--p-2)
  border-bottom-right-radius var(--p-2)

  &::before
    content ''
    position absolute
    top 0
    left 0
    bottom 0
    width 5px
    border-radius 10px
    background var(--active-color-alpha-600)

.text
  margin 0
  font-size 14px
  line-height 1.45
  opacity 0.85

.error
  margin 0
  color var(--active-color)
  font-size 14px
