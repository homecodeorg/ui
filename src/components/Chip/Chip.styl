@import '../../theme'

.chip
  display inline-flex
  align-items center
  gap 2px
  background var(--accent-color-alpha-100)
  cursor pointer
  transition background 0.2s ease

  &:hover
    background var(--accent-color-alpha-200)

  &:not(:has(.remove))
    padding-right var(--chip-pad)

.size_xs
  --chip-pad var(--p-1)
  padding-left var(--chip-pad)
  border-radius var(--p-1)
  controlFontSize('xs')

.size_s
  --chip-pad var(--p-3)
  padding-left var(--chip-pad)
  border-radius var(--p-3)
  controlFontSize('m')

.size_m
  --chip-pad var(--p-5)
  padding-left var(--chip-pad)
  border-radius var(--p-5)
  controlFontSize('l')

.size_l
  --chip-pad var(--p-8)
  padding-left var(--chip-pad)
  border-radius var(--p-8)
  controlFontSize('xl')

.size_xl
  --chip-pad var(--p-10)
  padding-left var(--chip-pad)
  border-radius var(--p-10)
  controlFontSize('xl')

.selected
.selected:hover
  background var(--accent-color-alpha-300)


.content
  display flex
  align-items center

.remove
  display flex
  align-items center
  justify-content center
  transform scale(.6)
  opacity .3
  transition opacity .2s ease, transform .1s ease

  &:hover
    background-color var(--danger-color-alpha-300)
    transform scale(.8)

  svg
    transform scale(.8)

.chip:hover .remove
  opacity 1
