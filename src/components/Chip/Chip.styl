@import '../../theme'

// Chip height depends on size only, so plain, selected and removable chips
// line up in a row.
.chip
  display inline-flex
  align-items center
  box-sizing border-box
  height var(--chip-h)
  gap 2px
  white-space nowrap
  background var(--accent-color-alpha-100)
  transition background 0.2s ease

  &:not(:has(.remove))
    padding-right var(--chip-pad)

// Only chips with `onClick` react to hover
.clickable
  cursor pointer

  &:hover
    background var(--accent-color-alpha-200)

.size_xs
  --chip-h $controlSizeXS
  --chip-pad var(--p-1)
  padding-left var(--chip-pad)
  border-radius var(--p-1)
  controlFontSize('xs')

.size_s
  --chip-h $controlSizeS
  --chip-pad var(--p-3)
  padding-left var(--chip-pad)
  border-radius var(--p-3)
  controlFontSize('m')

.size_m
  --chip-h $controlSizeM
  --chip-pad var(--p-5)
  padding-left var(--chip-pad)
  border-radius var(--p-5)
  controlFontSize('l')

.size_l
  --chip-h $controlSizeL
  --chip-pad var(--p-8)
  padding-left var(--chip-pad)
  border-radius var(--p-8)
  controlFontSize('xl')

.size_xl
  --chip-h $controlSizeXL
  --chip-pad var(--p-10)
  padding-left var(--chip-pad)
  border-radius var(--p-10)
  controlFontSize('xl')

.chip.selected
.chip.selected:hover
  background var(--accent-color-alpha-300)

.content
  display flex
  align-items center

// Remove button is a square fitting the chip height
.chip .remove
  display flex
  align-items center
  justify-content center
  flex none
  box-sizing border-box
  width var(--chip-h)
  height var(--chip-h)
  min-width var(--chip-h)
  min-height var(--chip-h)
  max-height var(--chip-h)
  padding 0
  transform scale(.6)
  opacity .3
  transition opacity .2s ease, transform .1s ease

  &:hover
    background-color var(--danger-color-alpha-300)
    transform scale(.8)

  svg
    transform scale(.8)

.chip:hover .remove
  opacity 1
