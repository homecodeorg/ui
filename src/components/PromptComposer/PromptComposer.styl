INPUT_MAX_HEIGHT = 200px

.root
  width 100%

.scroller
  width 100%
  flex 1
  min-height 40px
  max-height INPUT_MAX_HEIGHT

.editorMount
  display flex
  flex 1
  flex-direction column
  min-width 0
  min-height 40px
  border none
  padding 0 !important
  border-radius 0 !important
  box-shadow none !important
  background transparent

  &:focus-within
    box-shadow none !important

  .promptComposerEditor
    outline none !important
    border none !important
    flex 1
    padding var(--p-2) 0 0 !important
    margin 0
    white-space pre-wrap
    word-break break-word
    resize none !important
    box-shadow none !important
    min-height 40px !important
    overflow hidden !important

    transition opacity .1s ease-out

    .promptComposerLink
      color var(--link-color)

    a
      color var(--link-color)
      &:hover
        opacity 0.8
        cursor pointer

  & .promptComposerEmptyNode::before
    color var(--muted-foreground)
    opacity .3
    content attr(data-placeholder)
    float left
    height 0
    pointer-events none


  .promptComposerList
    margin 0
    padding-left 1.4em
    list-style disc

    li
      margin 0

    p
      margin 0

  // Quotes look like system rows in a chat: dimmed text, bar on the left.
  .promptComposerQuote
    position relative
    margin 0 0 var(--p-1)
    padding 2px 0 2px calc(4px + var(--p-2))
    font-size 85%
    color var(--accent-color-alpha-600)
    white-space pre-wrap
    cursor default

    &::before
      content ''
      position absolute
      top 2px
      bottom 2px
      left 2px
      width 4px
      border-radius 2px
      background var(--accent-color)
      opacity .3
      pointer-events none

    p
      margin 0

  div.promptComposerQuote
    user-select none

    &.ProseMirror-selectednode
      border-radius 4px
      background var(--accent-color-alpha-100)

      &::before
        opacity .7
